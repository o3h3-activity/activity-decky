{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"import",
		"jsdoc",
		"jsx-a11y",
		"oxc",
		"promise",
		"react-perf",
		"react",
		"typescript",
		"unicorn",
		"vitest"
	],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true
	},
	"globals": {
		"SteamClient": "readonly"
	},
	"options": {
		"typeAware": true,
		"typeCheck": true
	},
	"rules": {
		// ── TypeScript type-aware (migrated from ESLint; oxlint now owns these) ────
		// Options ported verbatim from the former eslint.config.js declarations.
		"no-floating-promises": ["error", { "ignoreVoid": true }],
		"no-misused-promises": [
			"error",
			{ "checksVoidReturn": { "attributes": false } }
		],
		"restrict-template-expressions": [
			"error",
			{ "allowNumber": true, "allowBoolean": true }
		],
		"switch-exhaustiveness-check": "error",
		"consistent-type-imports": [
			"error",
			{ "prefer": "type-imports", "fixStyle": "inline-type-imports" }
		],
		"consistent-type-exports": "error",
		"prefer-nullish-coalescing": "error",
		"no-unused-vars": [
			"error",
			{
				"args": "all",
				"argsIgnorePattern": "^_",
				"caughtErrors": "all",
				"caughtErrorsIgnorePattern": "^_",
				"destructuredArrayIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"ignoreRestSiblings": true
			}
		],
		"explicit-function-return-type": [
			"error",
			{
				"allowExpressions": true,
				"allowTypedFunctionExpressions": true,
				"allowHigherOrderFunctions": true,
				"allowIIFEs": true
			}
		],

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=react_perf
		"jsx-no-new-object-as-prop": "error",
		// These settings controls are not memoized children; callbacks need no identity guarantee.
		"jsx-no-new-function-as-prop": "off",
		"jsx-no-new-array-as-prop": "error",
		"jsx-no-jsx-as-prop": "error",

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=vitest
		"warn-todo": "error",
		"valid-title": "error",
		"valid-expect-in-promise": "error",
		"valid-expect": "error",
		"valid-describe-callback": "error",
		"require-top-level-describe": "error",
		"require-to-throw-message": "error",
		// Forcing an explicit timeout on every test is noise, not a quality signal.
		"require-test-timeout": "off",
		"require-mock-type-parameters": "error",
		"require-local-test-context-for-concurrent-snapshots": "error",
		"require-hook": "error",
		"require-awaited-expect-poll": "error",
		"prefer-todo": "error",
		"prefer-to-have-length": "error",
		"prefer-to-have-been-called-times": "error",
		"prefer-to-contain": "error",
		"prefer-to-be-truthy": "error",
		"prefer-to-be-object": "error",
		"prefer-to-be-falsy": "error",
		"prefer-to-be": "error",
		"prefer-strict-equal": "error",
		"prefer-strict-boolean-matchers": "error",
		"prefer-spy-on": "error",
		"prefer-snapshot-hint": "error",
		"prefer-mock-return-shorthand": "error",
		"prefer-mock-promise-shorthand": "error",
		"prefer-lowercase-title": "error",
		"prefer-importing-vitest-globals": "error",
		"prefer-import-in-mock": "error",
		"prefer-hooks-on-top": "error",
		"prefer-hooks-in-order": "error",
		"prefer-expect-type-of": "error",
		"prefer-expect-resolves": "error",
		"prefer-expect-assertions": "error",
		"prefer-equality-matcher": "error",
		"prefer-each": "error",
		// Stylistic; conflicts with descriptive string describe() titles.
		"prefer-describe-function-title": "off",
		"prefer-comparison-matcher": "error",
		"prefer-called-with": "error",
		// Conflicts with prefer-called-once for exactly one call; prefer the clearer matcher.
		"prefer-called-times": "off",
		"prefer-called-once": "error",
		"prefer-called-exactly-once-with": "error",
		"padding-around-test-blocks": "error",
		"padding-around-after-all-blocks": "error",
		"no-unneeded-async-expect-function": "error",
		"no-test-return-statement": "error",
		"no-test-prefixes": "error",
		"no-standalone-expect": "error",
		"no-restricted-vi-methods": "error",
		"no-restricted-matchers": "error",
		"no-mocks-import": "error",
		"no-large-snapshots": "error",
		"no-interpolation-in-snapshots": "error",
		// Contradicts prefer-importing-vitest-globals (both can't hold); we import.
		"no-importing-vitest-globals": "off",
		"no-import-node-test": "error",
		"no-identical-title": "error",
		"no-hooks": "error",
		"no-focused-tests": "error",
		"no-duplicate-hooks": "error",
		"no-disabled-tests": "error",
		"no-conditional-tests": "error",
		"no-conditional-in-test": "error",
		"no-conditional-expect": "error",
		"no-commented-out-tests": "error",
		"no-alias-methods": "error",
		"max-nested-describe": "error",
		"max-expects": "error",
		"hoisted-apis-on-top": "error",
		"expect-expect": "error",
		"consistent-vitest-vi": "error",
		"consistent-test-it": "error",
		"consistent-test-filename": "error",
		"consistent-each-for": "error",

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=react
		"void-use-memo": "error",
		"void-dom-elements-no-children": "error",
		"use-memo": "error",
		"unsupported-syntax": "error",
		// React Compiler cannot lower try/finally yet; this is not a source error.
		"todo": "off",
		"syntax": "error",
		"style-prop-object": "error",
		"static-components": "error",
		"state-in-constructor": "error",
		"set-state-in-render": "error",
		"set-state-in-effect": "error",
		"self-closing-comp": "error",
		"rules-of-hooks": "error",
		"rule-suppression": "error",
		"require-render-return": "error",
		"refs": "error",
		// Obsolete under the React 17+ automatic JSX transform.
		"react-in-jsx-scope": "off",
		"purity": "error",
		"preserve-manual-memoization": "error",
		"prefer-function-component": "error",
		"prefer-es6-class": "error",
		"only-export-components": "error",
		"no-will-update-set-state": "error",
		"no-unstable-nested-components": "error",
		"no-unsafe": "error",
		"no-unknown-property": "error",
		"no-unescaped-entities": "error",
		"no-this-in-sfc": "error",
		"no-string-refs": "error",
		"no-set-state": "error",
		"no-render-return-value": "error",
		"no-redundant-should-component-update": "error",
		"no-react-children": "error",
		"no-object-type-as-default-prop": "error",
		"no-namespace": "error",
		"no-multi-comp": "error",
		"no-is-mounted": "error",
		"no-find-dom-node": "error",
		"no-direct-mutation-state": "error",
		"no-did-update-set-state": "error",
		"no-did-mount-set-state": "error",
		"no-deriving-state-in-effects": "error",
		"no-danger-with-children": "error",
		"no-danger": "error",
		"no-clone-element": "error",
		"no-children-prop": "error",
		"no-array-index-key": "error",
		"memo-dependencies": "error",
		"jsx-props-no-spreading": "error",
		"jsx-props-no-spread-multi": "error",
		"jsx-pascal-case": "error",
		"jsx-no-useless-fragment": "error",
		"jsx-no-undef": "error",
		"jsx-no-target-blank": "error",
		"jsx-no-script-url": "error",
		// Forces all JSX text through i18n; we do not run i18n.
		"jsx-no-literals": "off",
		"jsx-no-duplicate-props": "error",
		"jsx-no-constructed-context-values": "error",
		"jsx-no-comment-textnodes": "error",
		// Depth cap of 2 is unrealistic for real component trees.
		"jsx-max-depth": "off",
		"jsx-key": "error",
		"jsx-handler-names": "error",
		"jsx-fragments": "error",
		// Misconfigured: repo is .tsx, not .jsx.
		"jsx-filename-extension": "off",
		"jsx-curly-brace-presence": "error",
		"jsx-boolean-value": "error",
		"invariant": "error",
		"incompatible-library": "error",
		"immutability": "error",
		"iframe-missing-sandbox": "error",
		"hooks": "error",
		"hook-use-state": "error",
		"globals": "error",
		"function-component-definition": "error",
		"forward-ref-uses-ref": "error",
		"forbid-elements": "error",
		"forbid-dom-props": "error",
		"forbid-component-props": "error",
		"exhaustive-effect-dependencies": "error",
		"exhaustive-deps": "error",
		"error-boundaries": "error",
		"display-name": "error",
		"checked-requires-onchange-or-readonly": "error",
		"capitalized-calls": "error",
		"button-has-type": "error",

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=unicorn
		"throw-new-error": "error",
		"text-encoding-identifier-case": "error",
		"switch-case-break-position": "error",
		"switch-case-braces": "error",
		"require-post-message-target-origin": "error",
		"require-number-to-fixed-digits-argument": "error",
		"require-module-specifiers": "error",
		"require-module-attributes": "error",
		"require-array-join-separator": "error",
		"relative-url-style": "error",
		"prefer-type-error": "error",
		"prefer-top-level-await": "error",
		"prefer-ternary": "error",
		"prefer-structured-clone": "error",
		"prefer-string-trim-start-end": "error",
		"prefer-string-slice": "error",
		"prefer-string-replace-all": "error",
		"prefer-string-raw": "error",
		"prefer-spread": "error",
		"prefer-single-call": "error",
		"prefer-set-has": "error",
		// Keep the existing Response constructor for Steam's embedded browser.
		"prefer-response-static-json": "off",
		"prefer-regexp-test": "error",
		"prefer-reflect-apply": "error",
		"prefer-query-selector": "error",
		"prefer-prototype-methods": "error",
		"prefer-optional-catch-binding": "error",
		"prefer-object-from-entries": "error",
		"prefer-number-properties": "error",
		"prefer-number-coercion": "error",
		"prefer-node-protocol": "error",
		"prefer-negative-index": "error",
		"prefer-native-coercion-functions": "error",
		"prefer-module": "error",
		"prefer-modern-math-apis": "error",
		"prefer-modern-dom-apis": "error",
		"prefer-math-trunc": "error",
		"prefer-math-min-max": "error",
		"prefer-logical-operator-over-ternary": "error",
		"prefer-keyboard-event-key": "error",
		"prefer-includes": "error",
		"prefer-import-meta-properties": "error",
		// Steam patches alias `window`; globalThis rewrite conflicts with that pattern.
		"prefer-global-this": "off",
		"prefer-export-from": "error",
		"prefer-event-target": "error",
		"prefer-dom-node-text-content": "error",
		"prefer-dom-node-remove": "error",
		"prefer-dom-node-dataset": "error",
		"prefer-dom-node-append": "error",
		"prefer-default-parameters": "error",
		"prefer-date-now": "error",
		"prefer-code-point": "error",
		"prefer-classlist-toggle": "error",
		"prefer-class-fields": "error",
		"prefer-blob-reading-methods": "error",
		"prefer-bigint-literals": "error",
		"prefer-at": "error",
		"prefer-array-some": "error",
		"prefer-array-index-of": "error",
		"prefer-array-flat-map": "error",
		"prefer-array-flat": "error",
		"prefer-array-find": "error",
		"prefer-add-event-listener": "error",
		"numeric-separators-style": "error",
		"number-literal-case": "error",
		"no-zero-fractions": "error",
		"no-useless-undefined": "off",
		"no-useless-switch-case": "error",
		"no-useless-promise-resolve-reject": "error",
		"no-useless-iterator-to-array": "error",
		"no-useless-error-capture-stack-trace": "error",
		"no-useless-collection-argument": "error",
		"no-unreadable-iife": "error",
		"no-unreadable-array-destructuring": "error",
		"no-unnecessary-slice-end": "error",
		"no-unnecessary-array-splice-count": "error",
		"no-unnecessary-array-flat-depth": "error",
		"no-typeof-undefined": "error",
		"no-this-assignment": "error",
		// Steam patch modules use static-only classes as namespaces by design.
		"no-static-only-class": "off",
		"no-process-exit": "error",
		"no-object-as-default-parameter": "error",
		"no-null": "error",
		"no-new-buffer": "error",
		"no-nested-ternary": "error",
		"no-negation-in-equality-check": "error",
		"no-magic-array-flat-depth": "error",
		"no-length-as-slice-end": "error",
		"no-instanceof-builtins": "error",
		"no-instanceof-array": "error",
		"no-immediate-mutation": "error",
		"no-hex-escape": "error",
		"no-document-cookie": "error",
		"no-console-spaces": "error",
		"no-confusing-array-with": "error",
		"no-await-expression-member": "error",
		// Steam's JS runtime may not implement toSorted; in-place sorts are intentional.
		"no-array-sort": "off",
		"no-array-reverse": "error",
		"no-array-reduce": "error",
		"no-array-method-this-argument": "error",
		"no-array-for-each": "off",
		"no-array-fill-with-reference-type": "error",
		// Wrapping every iterator callback in an arrow is overkill.
		"no-array-callback-reference": "off",
		"no-anonymous-default-export": "error",
		"no-accessor-recursion": "error",
		"no-abusive-eslint-disable": "error",
		"new-for-builtins": "error",
		"max-nested-calls": "error",
		"import-style": "error",
		// Repo uses camelCase filenames (Steam domain vocab); kebab-case is off.
		"filename-case": "off",
		"explicit-timer-delay": "error",
		"explicit-length-check": "error",
		"escape-case": "error",
		"error-message": "error",
		"empty-brace-spaces": "error",
		"custom-error-definition": "error",
		"consistent-template-literal-escape": "error",
		"consistent-function-scoping": "error",
		"consistent-existence-index-check": "error",
		"consistent-empty-array-spread": "error",
		"consistent-date-clone": "error",
		"consistent-assert": "error",
		"catch-error-name": "error",

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=promise
		"valid-params": "error",
		"spec-only": "error",
		"prefer-catch": "error",
		"prefer-await-to-then": "error",
		"prefer-await-to-callbacks": "error",
		"param-names": "error",
		// Promise.resolve() in replacePatch handlers returns a value intentionally.
		"no-return-wrap": "off",
		"no-return-in-finally": "error",
		"no-promise-in-callback": "error",
		"no-new-statics": "error",
		"no-nesting": "error",
		"no-multiple-resolved": "error",
		"no-callback-in-promise": "error",
		"catch-or-return": "error",
		"avoid-new": "error",
		"always-return": "error",

		// https://oxc.rs/docs/guide/usage/linter/rules.html?sort=default&dir=desc&scope=eslint
		"yoda": "error",
		"vars-on-top": "error",
		"unicode-bom": "error",
		"symbol-description": "error",
		"sort-vars": "error",
		// Alphabetical key order fights semantic grouping; Biome owns sorting.
		"sort-keys": "off",
		"require-unicode-regexp": "error",
		// Async wrappers preserve Promise-returning interfaces even without await.
		"require-await": "off",
		"radix": "error",
		"preserve-caught-error": "error",
		"prefer-template": "error",
		"prefer-rest-params": "error",
		"prefer-regex-literals": "error",
		"prefer-promise-reject-errors": "error",
		"prefer-object-spread": "error",
		"prefer-object-has-own": "error",
		"prefer-numeric-literals": "error",
		// Named capture groups are noise for simple single-group matches.
		"prefer-named-capture-group": "off",
		"prefer-exponentiation-operator": "error",
		"prefer-destructuring": "off",
		"prefer-const": "error",
		"prefer-arrow-callback": "error",
		"operator-assignment": "error",
		"object-shorthand": "error",
		"no-warning-comments": "error",
		// Contradicts no-floating-promises `ignoreVoid`; `void promise` is idiomatic here.
		"no-void": "off",
		"no-var": "error",
		"no-useless-return": "error",
		"no-useless-constructor": "error",
		"no-useless-concat": "error",
		"no-useless-computed-key": "error",
		"no-useless-call": "error",
		"no-useless-assignment": "error",
		"no-use-before-define": "error",
		"no-unreachable-loop": "error",
		"no-unneeded-ternary": "error",
		// AbortSignal is mutated by callers, not in the polling loop itself.
		"no-unmodified-loop-condition": "off",
		"no-unexpected-multiline": "error",
		"no-underscore-dangle": "error",
		"no-undef": "error",
		"no-throw-literal": "error",
		// Banning all ternaries is extreme; no-nested/no-unneeded-ternary suffice.
		"no-ternary": "off",
		"no-template-curly-in-string": "error",
		"no-shadow": "error",
		"no-sequences": "error",
		"no-self-compare": "error",
		"no-script-url": "error",
		"no-return-assign": "error",
		"no-restricted-properties": "error",
		"no-restricted-imports": "error",
		"no-restricted-globals": "error",
		"no-restricted-exports": "error",
		"no-regex-spaces": "error",
		"no-redeclare": "error",
		"no-prototype-builtins": "error",
		"no-proto": "error",
		"no-promise-executor-return": "error",
		// Stylistic; `++`/`--` are fine.
		"no-plusplus": "off",
		"no-param-reassign": "error",
		"no-object-constructor": "error",
		"no-new-wrappers": "error",
		"no-new-func": "error",
		"no-new": "error",
		"no-negated-condition": "error",
		"no-multi-str": "error",
		"no-multi-assign": "error",
		// Ignore common non-magic values and array indices; require const for the rest.
		"no-magic-numbers": [
			"error",
			{
				"ignore": [-1, 0, 1, 2],
				"ignoreArrayIndexes": true,
				"enforceConst": true,
				"ignoreEnums": true,
				"ignoreNumericLiteralTypes": true,
				"ignoreReadonlyClassProperties": true
			}
		],
		"no-loop-func": "error",
		"no-lonely-if": "error",
		"no-lone-blocks": "error",
		"no-labels": "error",
		"no-label-var": "error",
		"no-inner-declarations": "error",
		// Trailing comments are fine.
		"no-inline-comments": "off",
		"no-implied-eval": "error",
		"no-implicit-globals": "error",
		"no-implicit-coercion": "error",
		"no-fallthrough": "error",
		"no-extra-label": "error",
		"no-extra-bind": "error",
		"no-extend-native": "error",
		"no-eq-null": "error",
		"no-empty-function": "error",
		"no-empty": "error",
		"no-else-return": "error",
		"no-duplicate-imports": "error",
		"no-div-regex": "error",
		// Stylistic; `continue` is fine.
		"no-continue": "off",
		"no-constructor-return": "error",
		"no-console": "warn",
		"no-case-declarations": "error",
		// Bitwise ops are required for SteamID math.
		"no-bitwise": "off",
		// Sequential awaits in a loop are sometimes intentional.
		"no-await-in-loop": "off",
		"no-array-constructor": "error",
		"no-alert": "error",
		// Allow factory/Number()-style calls with capitalized names.
		"new-cap": ["error", { "capIsNew": false }],
		"max-statements": ["error", { "max": 25 }],
		"max-params": ["error", { "max": 4 }],
		"max-nested-callbacks": "error",
		// Arbitrary line caps encourage splitting cohesive Steam patchers and tests.
		"max-lines-per-function": "off",
		"max-lines": "off",
		"max-depth": "error",
		"max-classes-per-file": "off",
		"logical-assignment-operators": "error",
		// Conflicts with `let x; try { x = ... }` initialization patterns.
		"init-declarations": "off",
		"id-match": "error",
		// Short comparator/loop identifiers are fine.
		"id-length": "off",
		"id-denylist": "error",
		"guard-for-in": "error",
		"grouped-accessor-pairs": "error",
		// Style-only; conflicts with hoisted top-level function declarations.
		"func-style": "off",
		// Anonymous function expressions are fine.
		"func-names": "off",
		"func-name-matching": "error",
		"eqeqeq": "error",
		"default-param-last": "error",
		"default-case-last": "error",
		"default-case": "error",
		"curly": "error",
		"complexity": "error",
		// Patchers implement instance interfaces even when a method needs no instance state.
		"class-methods-use-this": "off",
		// Comment casing is noise.
		"capitalized-comments": "off",
		"block-scoped-var": "error",
		"arrow-body-style": "error",
		"array-callback-return": "error",
		"accessor-pairs": "error"
	},
	"overrides": [
		{
			"files": ["src/steam/**"],
			"rules": {
				"prefer-await-to-then": "off",
				"prefer-await-to-callbacks": "off"
			}
		},
		{
			"files": ["src/utils/logger.ts"],
			"globals": { "process": "readonly" },
			"rules": {
				"no-console": "off"
			}
		},
		{
			"files": ["verify/**/*.ts"],
			"globals": { "process": "readonly" },
			"rules": {
				"no-console": "off"
			}
		}
	],
	// Generated Steam API declarations are outside tsconfig and not ours to lint.
	"ignorePatterns": ["dist/**", "*.js", "server-v2/**", "steam-deck-api.d.ts"]
}
