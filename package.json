{
	"name": "activity",
	"version": "0.0.2",
	"description": "",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"watch": "vite build --watch",
		"lint": "e=0; pnpm run lint:frontend || e=1; pnpm run lint:python || e=1; exit $e",
		"lint:frontend": "e=0; biome lint . || e=1; oxlint || e=1; eslint --config ./eslint.config.js '**/*.tsx' '**/*.ts' || e=1; exit $e",
		"lint:fix": "e=0; biome check --write . || e=1; oxlint --fix || e=1; eslint --config ./eslint.config.js '**/*.tsx' '**/*.ts' --fix || e=1; pnpm run lint:python:fix || e=1; exit $e",
		"lint:python": "uv run --locked ruff check .",
		"lint:python:fix": "uv run --locked ruff check --fix . && uv run --locked ruff format .",
		"format:python:check": "uv run --locked ruff format --check .",
		"typecheck:frontend": "tsc --noEmit",
		"typecheck:python": "uv run --locked basedpyright",
		"test:python": "uv run --locked python -m unittest discover -s tests",
		"check:python": "pnpm run lint:python && pnpm run format:python:check && pnpm run typecheck:python && pnpm run test:python",
		"test": "pnpm run test:frontend && pnpm run test:python",
		"test:frontend": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/o3h3-activity/activity-decky.git"
	},
	"keywords": [
		"decky",
		"plugin",
		"activity",
		"steam-deck",
		"deck",
		"social",
		"non-steam",
		"emulation"
	],
	"author": "ynhhoJ <22500212+ynhhoJ@users.noreply.github.com",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/o3h3-activity/activity-decky/issues"
	},
	"homepage": "https://github.com/o3h3-activity/activity-decky#readme",
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@decky/ui": "4.16.5",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "6.0.0",
		"@tailwindcss/node": "^4.3.5",
		"@tailwindcss/oxide": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/react": "19.1.1",
		"@types/react-dom": "19.1.1",
		"@types/react-router": "5.1.20",
		"@types/webpack": "^5.28.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "10.15.0",
		"eslint-plugin-array-func": "^5.1.1",
		"eslint-plugin-oxlint": "1.93.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-unicorn": "80.0.0",
		"globals": "^17.14.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"react": "19.1.1",
		"tailwindcss": "^4.3.5",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vite-plugin-external": "^8.0.4",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@decky/api": "^1.1.3",
		"@legendapp/state": "3.0.0-beta.48",
		"es-toolkit": "1.53.2",
		"nanoevents": "^10.0.0",
		"qr": "^0.7.2",
		"react-icons": "^5.7.0",
		"tslib": "2.9.1"
	}
}
